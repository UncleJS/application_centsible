# ── Centsible — repo-local env (gitignored) ──────────────────────────────────
# Copy to `.env` and fill in real values. This file is the SINGLE SOURCE OF
# TRUTH for both local development (`bun run`) and the Quadlet/Podman stack
# (`infra/deploy.sh`). Do not duplicate it under `~/.config/containers/systemd/`.

# ── Runtime ──────────────────────────────────────────────────────────────────
# Local dev:   leave unset (defaults to development behavior)
# Quadlet:     the unit files set NODE_ENV=production via Environment=
NODE_ENV=development

# ── Database (used by the API) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=centsible
DB_PASSWORD=centsible_dev
DB_NAME=centsible

# ── MariaDB container bootstrap (Quadlet only) ───────────────────────────────
# Consumed by the official MariaDB image on first boot. Must match DB_USER /
# DB_PASSWORD / DB_NAME above so the API can connect.
# Also consumed by the E2E test-DB bootstrap (packages/api/src/db/test-setup.ts)
# to create + grant access to the `centsible_test` schema.
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=centsible
MARIADB_USER=centsible
MARIADB_PASSWORD=centsible_dev

# ── API ──────────────────────────────────────────────────────────────────────
# Local dev port. Quadlet overrides to 10301 via Environment= in the unit.
API_PORT=4000

# Required. Generate with: openssl rand -hex 32
# The API refuses to start in production with the placeholder values below.
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-random-secret-in-production

# Required when Swagger /docs is fronted by NODE_ENV=production. Anyone with
# this token can read the API schema. Leave empty in dev to keep /docs open.
DOCS_AUTH_TOKEN=

# Origin allowed by CORS. Dev = http://localhost:3000; Quadlet overrides to
# http://localhost:10300 via Environment= in the unit.
WEB_URL=http://localhost:3000

# Rate limits (per IP, per RATE_LIMIT_WINDOW_MS).
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
GENERAL_RATE_LIMIT_MAX=100

# Set to true ONLY when the API sits behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Real-IP. Misconfiguring this lets clients spoof their IP.
TRUST_PROXY_HEADERS=false

# ── Web ──────────────────────────────────────────────────────────────────────
# Where the browser reaches the API. Quadlet sets this to http://localhost:10301
# at build time via --build-arg, so production builds bake it in.
VITE_API_URL=http://localhost:4000

# ── Exchange rates ───────────────────────────────────────────────────────────
# Upstream rate source. Defaults to Frankfurter
# (https://api.frankfurter.app — set in packages/shared/src/constants.ts).
# The E2E suite overrides this to an unreachable host so tests stay offline and
# exercise the cached-rate fallback path. Leave unset for normal dev/prod.
# EXCHANGE_RATE_API_BASE=https://api.frankfurter.app
