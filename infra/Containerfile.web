# ── Centsible Web (Vite SPA, served by Caddy) ────────────────
# Multi-stage build: Bun installs + builds the static SPA,
# Caddy serves /srv at :10300 with SPA fallback.
# Build context: monorepo root (../../)
# Usage: podman build -t centsible-web:latest -f infra/Containerfile.web .

# ── Stage 1: Install dependencies ────────────────────────────
FROM docker.io/oven/bun:1.3.14-alpine AS deps

WORKDIR /app

# Copy ALL workspace package.json files for lockfile resolution
COPY package.json bunfig.toml bun.lock ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/web/package.json packages/web/

# Install all dependencies (including dev for build)
RUN bun install --frozen-lockfile

# ── Stage 2: Build ───────────────────────────────────────────
FROM docker.io/oven/bun:1.3.14-alpine AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/web/node_modules ./packages/web/node_modules

# Copy source
COPY package.json bunfig.toml tsconfig.json ./
COPY bun.lock ./
COPY packages/api/package.json packages/api/
COPY packages/shared/package.json packages/shared/
COPY packages/web/package.json packages/web/
COPY packages/shared/ packages/shared/
COPY packages/web/ packages/web/

# Re-link workspace dependencies after source copy so package binaries
# like `vite` are available during the build step.
RUN bun install --frozen-lockfile

# Build-time env: VITE_* is baked into the client JS bundle at build time.
# Always pass the correct value via --build-arg when building for production.
# Default here matches the pod-internal port used by centsible-api.
ARG VITE_API_URL=http://localhost:10301
ENV VITE_API_URL=$VITE_API_URL

RUN cd packages/web && bun run build

# ── Stage 3: Production runtime (Caddy static server) ────────
FROM docker.io/caddy:2-alpine AS runtime

# Static SPA assets — Caddy's default Caddyfile serves /srv with SPA fallback.
COPY --from=build /app/packages/web/dist /srv
COPY infra/web/Caddyfile /etc/caddy/Caddyfile

EXPOSE 10300

# Caddy's default ENTRYPOINT runs the server with /etc/caddy/Caddyfile.
